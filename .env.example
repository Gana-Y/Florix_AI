# Florix AI Environment Variables Reference
# For complete backend configuration, see Backend/.env.example

# Core AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Authentication
JWT_SECRET=replace_with_32_character_hex_string

# Database URL
DATABASE_URL=sqlite:///./florix.db
# Production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/florix_ai

# Environment
ENVIRONMENT=development
PORT=8000
