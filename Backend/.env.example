# ── COPY THIS FILE TO .env AND FILL IN YOUR REAL VALUES ──────────────────────
# NEVER commit the actual .env file to version control.

# Google Gemini API Key — get from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret — generate a strong one with: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be at least 32 characters and completely random
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Database URL
# Development (SQLite):
DATABASE_URL=sqlite:///./florix.db
# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@localhost:5432/florix_ai

# Optional: Token expiry in minutes (default: 10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Optional: Max upload size in MB
MAX_UPLOAD_SIZE_MB=50

# Optional: Environment tag
ENVIRONMENT=development

# Admin Payment Configuration (set these before deploying!)
ADMIN_MOBILE_NUMBER="+91 XXXXXXXXXX"
ADMIN_UPI_ID="yourname@upi"

# Production Mode (set to true to hide demo tokens)
PRODUCTION_MODE=false

# Email Configuration (optional - for email verification)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password

# ── Razorpay Payment Gateway ──────────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Get this from https://dashboard.razorpay.com/app/webhooks (optional for backup updates)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
